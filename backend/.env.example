# ============================================================
# 复制为 backend/.env 并按需修改。.env 已被 .gitignore 忽略，不会入库。
# ============================================================

# 环境标识：dev / prod（prod 下 SECRET_KEY 与 API_KEY_ENCRYPTION_KEY 必填）
ENV=dev

# 数据库（docker compose up -d 后即是以下默认值）
DATABASE_URL=postgresql+asyncpg://ielts:ielts_dev_password@localhost:5432/ielts_coach

# Redis；留空则使用进程内缓存（仅限本地开发）
# REDIS_URL=redis://localhost:6379/0

# JWT 签名密钥，生成方式：
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# API Key 加密主密钥（AES-256-GCM，64 位 hex），生成方式同上
API_KEY_ENCRYPTION_KEY=

# 火山引擎方舟（豆包 LLM）
# 平台默认 API Key：用户未配置 BYOK Key 时回退使用；留空则要求用户必须自带 Key
VOLC_ARK_DEFAULT_API_KEY=
# 可用模型（2026-08 实测）：doubao-seed-2-1-turbo-260628 / doubao-seed-2-1-pro-260628 /
# doubao-seed-2-0-lite-260428 / deepseek-v4-flash-260425
VOLC_ARK_TEST_MODEL=doubao-seed-2-1-turbo-260628
# VOLC_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 火山引擎语音服务（平台默认凭据，用户 BYOK 存数据库）
# 在「语音控制台 → 应用管理」创建应用后获得 APPID 和 Access Token
VOLC_ASR_APPID=
VOLC_ASR_ACCESS_TOKEN=
# 豆包流式语音识别 2.0；1.0 为 volc.bigasr.sauc.duration
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_TTS_APPID=
VOLC_TTS_ACCESS_TOKEN=
VOLC_TTS_RESOURCE_ID=volc.seedtts.default

# 口语评测（service_type 81，英文）：协议见 app/services/volcengine/evaluation.py 头注。
# 平台默认凭据留空时自动复用 VOLC_ASR_*；用户在「API 设置」页也可单独配置。
# CLUSTER 待语音控制台开通「口语评测」后按官方文档校准（当前实测所有值均报无可用实例）
VOLC_EVALUATION_APPID=
VOLC_EVALUATION_ACCESS_TOKEN=
VOLC_EVALUATION_CLUSTER=volcano_mdd

# 腾讯云智聆口语评测（英文发音评分）：控制台「访问管理 → API 密钥管理」创建
# 配置后评分的发音维度优先走腾讯云真实评测（火山口语评测为邀测，暂不可用）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# Mock 模式：不访问真实语音服务（开发/测试用）；置 1 后 ASR/TTS 走本地假实现
VOLC_MOCK=0

# 练习音频归档目录（相对 backend 运行目录）
STORAGE_DIR=./storage

# 跨域来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
