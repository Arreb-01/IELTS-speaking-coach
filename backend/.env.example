# ============================================================
# 复制为 backend/.env 并按需修改。.env 已被 .gitignore 忽略，不会入库。
# ============================================================

# 环境标识：dev / prod（prod 下 SECRET_KEY 与 API_KEY_ENCRYPTION_KEY 必填）
ENV=dev

# 数据库（docker compose up -d 后即是以下默认值）
DATABASE_URL=postgresql+asyncpg://ielts:ielts_dev_password@localhost:5432/ielts_coach

# Redis；留空则使用进程内缓存（仅限本地开发）
# REDIS_URL=redis://localhost:6379/0

# JWT 签名密钥，生成方式：
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# API Key 加密主密钥（AES-256-GCM，64 位 hex），生成方式同上
API_KEY_ENCRYPTION_KEY=

# 火山引擎方舟（豆包 LLM）
# 平台默认 API Key：用户未配置 BYOK Key 时回退使用；留空则要求用户必须自带 Key
VOLC_ARK_DEFAULT_API_KEY=
VOLC_ARK_TEST_MODEL=doubao-1.5-pro-32k-250115
# VOLC_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 跨域来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
